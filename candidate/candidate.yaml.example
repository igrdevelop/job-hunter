# candidate.yaml — edit this file with YOUR real data.
#
# This is the single source of truth for the candidate's identity, location,
# languages and employer history that the bot injects into generated CVs,
# cover letters, filters and LLM prompts. See candidate/README.md and
# docs/SETUP_NEW_USER.md for the full setup walkthrough.

identity:
  full_name: "Jane Doe"
  aka: ""                          # optional "also known as" subtitle on the CV; leave "" to omit
  cv_filename_prefix: "Jane_Doe_CV"  # generated files look like Jane_Doe_CV_Frontend_2026_EN.docx
  headline: "Senior Frontend Developer"
  contact: "+48 123 456 789 | jane@example.com | linkedin.com/in/janedoe | Warsaw, Poland"

location:
  home_city: "Warsaw"               # primary city used for filters and "wroc"-style substring checks
  home_city_aliases:                # lowercase variants the location filter should match
    - "warszawa"
    - "warsaw"
  acceptable_hybrid: ["Warsaw"]     # cities where hybrid is fine
  weekly_hybrid: ["Krakow"]         # cities acceptable for <=1 day/week hybrid
  work_authorization: "EU"          # EU | US | any — feeds the doomed-vacancy gate

languages:
  spoken: ["pl", "en"]              # all languages the candidate speaks
  cv_languages: ["en", "pl"]        # which CV language variants to generate
  disqualify_required:              # a posting REQUIRING one of these (that the candidate
    - "de"                          # doesn't speak) is a hard skip
    - "fr"
    - "nl"

employers:
  protected:                        # verifiable, real employers — never touched by the
    - "Company A"                   # verdict-refine loop's stretch rounds
    - "Company B"
    - "Company C"
  flexible:                         # one agency-style employer whose project list MAY
    name: "Agency X"                # absorb stretch-round tech additions (never invented
    period: "2018-2022"             # employers/metrics/years)
    projects:
      - "E-commerce"
      - "Healthcare"
      - "Insurance"
  real_companies:                   # lowercase names for the content-QA "is this a real
    - "company a"                   # employer" check — keep in sync with `protected` + `flexible.name`
    - "company b"
    - "company c"
    - "agency x"
  profile_titles:                   # canonical role titles as they appear in candidate_profile.md
    - "senior frontend developer"
    - "frontend developer"

  # Ordered employment history, newest first — the single source of truth
  # for the generation prompt's RED LINES table (rendered at call time by
  # hunter/gen_prompt.py; see prompts/generation_rules.md's
  # <!-- CANDIDATE_EMPLOYMENT_FACTS --> marker). `company` / `title` /
  # `period` are reproduced VERBATIM in every generated CV.
  #   backend         — what the backend actually was, so stack_line
  #                     enrichment cannot invent Node/NestJS where it was
  #                     something else. Omit when there's nothing to pin.
  #   bullets_max     — compression budget for older roles, so a 2-page CV
  #                     never drops a role entirely. Omit for no cap.
  #   legacy_stack_ok — true for era-appropriate 2010s-tech roles (jQuery
  #                     and similar) — an explicit flag, not derived from
  #                     dates.
  #   title_by_track  — optional per-track title override for THIS role
  #                     only (e.g. an AI-focused track naming this role
  #                     differently). This is the ONLY title variation the
  #                     prompt allows besides the Angular/React framework
  #                     swap — do not use it to adopt a job posting's own
  #                     label for the role.
  history:
    - company: "Company A"
      title: "Senior Frontend Developer (Angular)"
      period: "Jan 2023 - Present"
      title_by_track:
        ai: "AI Tooling Engineer"
    - company: "Company B"
      title: "Senior Frontend Developer (Angular)"
      period: "Mar 2021 - Dec 2022"
      backend: "Java"
    - company: "Agency X"
      title: "Frontend Developer"
      period: "Jun 2018 - Feb 2021"
      backend: ".NET"
      bullets_max: "2-3"
      legacy_stack_ok: true

education:
  school_keyword: "university of warsaw"   # lowercase substring used by the education QA check
  expected_role_count: 5                   # how many roles the generated resume_en should list

# Total experience as stated in summaries and cover letters. The generation
# prompt forbids rounding this down (e.g. never "9+" when this says "10+").
experience:
  years_label: "10+"
  since_year: 2015

tracks:
  base_cv:                          # stack key -> prompt filename (relative to candidate/)
    angular: "base_cv_angular.md"
    react: "base_cv_react.md"

# Source-specific location overrides (optional). Only needed for scrapers that
# hardcode a city in their listing URL (Pracuj.pl, theprotocol.it, JobLeads).
source_urls:
  pracuj_location: "warszawa"
  theprotocol_location: "warszawa"
  jobleads_location: "warszawa"
