# Copy this file to .env and fill in your values
# NEVER commit .env to git

TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Send the generated PDF/DOCX files via Telegram after each apply
TELEGRAM_SEND_DOCS=true

# AUTO_APPLY=true — auto-generate docs for all new jobs (no manual buttons)
AUTO_APPLY=false

# ── Multi-user / storage paths ────────────────────────────────────────────────
# The owner's users.id from the API's app.sqlite (multi-user). Stamps every
# tracker write in the bot process; unset = single-user dev mode.
#DEFAULT_USER_ID=

# Injected automatically into per-user apply subprocesses by hunter.users.user_env
# (wins over DEFAULT_USER_ID) — not meant to be set by hand in .env.
#JOB_HUNTER_USER_ID=

# Per-user storage root: users/{userId}/{candidate,Applications,templates}
# (shared with job-hunter-api via the compose mount). Default: ./users
#USERS_ROOT=./users

# Output folder for generated application documents. Default: ./Applications
#APPLICATIONS_DIR=./Applications

# SQLite tracker DB path. Env-overridable so Docker can point at a
# directory-mounted db shared with job-hunter-api. Default: ./tracker.db
#TRACKER_DB_PATH=./tracker.db

# Single-user overrides for the candidate/filters/generation YAML files —
# default is next to candidate/candidate.yaml. The multi-user path resolves
# these per-user instead (see hunter/users.py).
#CANDIDATE_YAML_PATH=candidate/candidate.yaml
#FILTERS_YAML_PATH=candidate/filters.yaml
#GENERATION_YAML_PATH=candidate/generation.yaml

# Which stacks the candidate applies for (docs/quality/09-multi-track-react.md).
# Set "angular,react" to also apply to React-only roles. Runtime override:
# /tracks angular|react|both in Telegram (DB key wins over this).
#CANDIDATE_TRACKS=angular

# ── LLM API config (for apply_agent.py API mode) ─────────────────────────────
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model name (OPTIONAL — leave commented to use the default from hunter/config.py,
# currently claude-sonnet-4-6). Only set this to override the code default (e.g. an
# experiment or a temporary cheaper model). Keeping the model in code means future
# upgrades ship as a normal commit + deploy instead of a manual edit on the server.
# Examples:
#   anthropic: claude-haiku-4-5 (cheap), claude-sonnet-4-6 (quality)
#   openai:    gpt-4o-mini (cheap), gpt-4o (quality)
#LLM_MODEL=claude-sonnet-4-6

# API key for the chosen provider
LLM_API_KEY=sk-ant-api03-...
# or for OpenAI:
# LLM_API_KEY=sk-proj-...
#
# Provider-specific keys are also read directly and take precedence over the
# generic LLM_API_KEY per provider (hunter/config.py). Use these when you keep
# more than one provider configured at once — e.g. Anthropic for generation and
# the judge, OpenRouter for the dual-apply shadow model:
#ANTHROPIC_API_KEY=sk-ant-api03-...
#OPENAI_API_KEY=sk-proj-...
#OPENROUTER_API_KEY=sk-or-v1-...

# Pin a named LLM profile as default (e.g. deepseek-r1), overriding
# LLM_PROVIDER+LLM_MODEL above. A /llm <name> selection in Telegram wins over
# this. See hunter/llm_profiles.py.
#LLM_DEFAULT_PROFILE=

# Model to switch to after half the retries on repeated overload (429/529)
# during call_llm. Optional — no fallback by default.
#LLM_FALLBACK_MODEL=

# ── LibreOffice (DOCX -> PDF rendering) ──────────────────────────────────────
# Default is "libreoffice" on PATH, which is right for Linux/Docker.
# On Windows point this at soffice.exe:
#SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe

# ── Independent ATS verdict + refine loop ────────────────────────────────────
# After generate_docs, one cheap-LLM call scores the RENDERED PDF (what a
# real ATS actually parses) against the job posting. If that score is below
# the target, hunter/verdict_refine.py rewrites resume_en against the
# verdict's own feedback (rounds 1-3 honest, round 4+ stretch — may add
# posting tech absent from the profile, logged to the "To Learn" column),
# re-renders, and re-verdicts, keeping only strict improvements.
# ATS_VERDICT_MAX_REFINES=0 disables the loop entirely (old one-shot verdict).
# Default 5 = three honest rounds + two stretch rounds (owner decisions
# 2026-07-07 / 2026-08-10 — CLI-subscription rounds are ~free).
# Run the final independent ATS verdict pass at all (see Step 7a in CLAUDE.md).
#ATS_VERDICT_ENABLED=true
#ATS_VERDICT_TARGET=95
#ATS_VERDICT_MAX_REFINES=5

# ── Outreach draft (issue #138) ───────────────────────────────────────────────
# After each successful apply, write outreach.md into the application folder:
# recruiter contact parsed from the posting (regex, $0) + a ready-to-paste
# <=300-char LinkedIn message (one cheap JUDGE_MODEL call). The file rides the
# Drive folder upload; the bot never sends anything itself.
#OUTREACH_ENABLED=true

# ── Claim judge (LLM-as-judge CV verification) ───────────────────────────────
# Second cheap-model pass that verifies every generated claim against the
# candidate profile + job posting and flags/repairs fabrications. See CLAUDE.md
# Step 5a-bis.
#JUDGE_ENABLED=true
# Cheap model for the judge (independent of the generator; always Anthropic).
#JUDGE_MODEL=claude-haiku-4-5-20251001
#JUDGE_PROVIDER=anthropic
# Judge API key (reads ANTHROPIC_API_KEY first, falls back to LLM_API_KEY).
#JUDGE_API_KEY=sk-ant-api03-...
# Rollout: report (artifact only) / warn (+Telegram) / block (+abort on a
# surviving fabrication).
#JUDGE_MODE=warn
# Repair rounds attempted before warn/block.
#JUDGE_MAX_REPAIR_ROUNDS=1

# ── PL/EN translation calls ───────────────────────────────────────────────────
# Mechanical PL<->EN translation (hunter.apply_shared._translate_resume /
# _translate_plain, used by the language enforce-gate and the verdict-refine
# PL mirror) is a Haiku-tier task, not worth the main profile's $/output-token
# rate. Defaults to the same cheap model as the claim judge; falls back to the
# main LLM profile if no key resolves (a translation must never fail outright
# for lack of a dedicated key). See docs/LLM_COST_REDUCTION_PLAN.md M5.
#TRANSLATE_PROVIDER=anthropic
#TRANSLATE_MODEL=claude-haiku-4-5-20251001
#TRANSLATE_API_KEY=sk-ant-api03-...

# ── Doomed-vacancy gate ───────────────────────────────────────────────────────
# Deterministic (regex-only, zero LLM cost) full-text screen run right after
# expired-check, before the first LLM call. HARD findings (non-Poland
# onsite/hybrid, non-EU work authorization, unsupported required language)
# write a SKIP tracker row and abort generation for $0.00; SOFT findings
# (e.g. stack mismatch) just warn in Telegram and generation continues.
# Force-mode/manual-paste always degrades HARD to warn. See
# docs/DOOMED_GATE_PLAN.md.
#DOOMED_GATE_ENABLED=true

# Stack pre-screen (docs/STACK_PRESCREEN_PLAN.md): one cheap-model read of which
# framework a posting is actually for, before the first generation call.
# Mode ships at `warn` (Telegram line, still generates). Flip to `skip` after a
# week of watching those warnings against real outcomes.
#PRESCREEN_ENABLED=true
#PRESCREEN_MODE=warn
#PRESCREEN_MIN_CONFIDENCE=0.9
# "skip" (default) aborts on HARD; "warn" is an emergency lever to downgrade
# every HARD finding to a warning without disabling the gate entirely.
#DOOMED_GATE_HARD_ACTION=skip

# ── Re-post gate ──────────────────────────────────────────────────────────────
# When the fetched posting is a near-verbatim re-post of a vacancy already
# applied to (new URL — re-listed after expiry, cross-board dup, agency name
# variation), reuse the existing CV at cost $0 instead of regenerating.
# See docs/DOOMED_GATE_PLAN.md sibling hunter/repost_gate.py.
#REPOST_GATE_ENABLED=true
# How many days back the gate looks for a donor application.
#REPOST_WINDOW_DAYS=60

# GDPR/RODO consent clause appended as the last body paragraph of the CV.
# "both" = PL+EN CVs, "pl" = PL CV only, "none" = off.
#CV_GDPR_CLAUSE=both

# ── CLI fallback ──────────────────────────────────────────────────────────────
# Set to true to use claude CLI instead of API (original approach, uses Pro plan)
APPLY_USE_CLI=false

# ── Resilience ────────────────────────────────────────────────────────────────
# LLM-outage CLI fallback has NO env flag: being ABLE TO AUTHENTICATE is the
# switch. An account outage (drained balance / bad key) then serves LLM calls
# through the Claude subscription — main generation AND the cheap stages
# (judge/verdict/translate/outreach) — and switches back to the API once
# topped up. Two ways to authenticate, checked in this order:
#
#   1. CLAUDE_CODE_OAUTH_TOKEN below — a long-lived token (~1 year), the
#      deploy-host method. It does not rotate, so it cannot be wiped by a
#      failed refresh the way an OAuth login can (2026-09-08 incident).
#   2. A logged-in ./.claude-cli volume (docker-compose; one-time
#      `docker compose exec -it job-hunter claude` OAuth) — the desktop
#      method, and the fallback if no token is set.
#
# To disable: unset the token AND empty ./.claude-cli (or `claude /logout` in
# the container). See docs/LLM_OUTAGE_RESILIENCE_PLAN.md + docs/DEPLOY.md.
#
# Generate once on the host, then paste the printed token here and restart:
#   docker compose exec -it job-hunter claude setup-token
# Personal subscription credential — treat like gsheets_token.json, never commit.
#CLAUDE_CODE_OAUTH_TOKEN=

# Alternate location of the Claude CLI's own config/credentials dir (method 2
# above — a logged-in ./.claude-cli volume). Only needed if it isn't the
# default ~/.claude.
#CLAUDE_CONFIG_DIR=

# How long auto-apply pauses after an LLM account outage (minutes). /llm outage
# clear lifts it early; see docs/LLM_OUTAGE_RESILIENCE_PLAN.md M2.
#LLM_OUTAGE_PAUSE_MIN=60

# Seconds to wait between auto-apply jobs in a batch
APPLY_DELAY_SEC=0

# Max jobs to process per single hunt run (prevents burning budget)
MAX_JOBS_PER_RUN=40

# Subprocess timeout for a plain API-mode apply run (seconds; 15 min default).
# apply_service widens this automatically for a CLI-eligible run — see
# APPLY_AGENT_CLI_TIMEOUT_SEC below.
APPLY_AGENT_TIMEOUT_SEC=900

# Generate Polish resume for every application (not just PL-language postings)
GENERATE_PL_RESUME=true

# Generate the Polish about_me text too (used by the --full doc mode and by
# the resume-profile preview, which forces this to false for its $0 guarantee).
GENERATE_ABOUT_ME_PL=true

# Skip generating resume_pl/cover_letter_pl/about_me_pl on the FIRST generation
# call for an English-language posting in short mode (they are ~40-50% of that
# call's output tokens and short mode never delivers them for an EN posting
# anyway). PL postings and --full runs are unaffected. See LLM_COST_REDUCTION_PLAN M4.
GEN_SKIP_PL_FOR_EN=true

# CLI mode retry on 529 overloaded errors
CLI_MAX_RETRIES=3
CLI_RETRY_DELAY=30

# One-release escape hatch (docs/improvement-2026-09/05-SECURITY_PLAN.md M1):
# restores the pre-M1 `claude -p --dangerously-skip-permissions` invocation
# instead of the explicit --allowedTools/--disallowedTools policy. Leave
# false unless the restricted policy is missing a tool the CLI skill needs.
APPLY_CLI_LEGACY_PERMS=false
# Post-start CLI canary (docs/APPLY_FAILURE_QUEUES_PLAN.md M1): once per bot
# start, when a Claude CLI login exists, run one trivial `claude -p` with the
# apply pipeline's own flags and alert in Telegram if it fails. One flat-cost
# subscription call per restart; no API spend.
CLI_CANARY_ENABLED=true

# ── LinkedIn session (для загрузки текста вакансий с LinkedIn) ────────────────
# БЕЗ этого файла КАЖДАЯ LinkedIn-вакансия падает на фетче (HTTP 429 в guest API)
# — это крупнейший источник FAIL-строк в трекере. Чтобы включить:
#   1. локально: python tools/linkedin_login.py  → создаст storage_state JSON
#   2. примонтировать файл в контейнер и указать путь ниже
#   3. после этого можно убрать linkedin.com из GMAIL_ENRICH_SKIP_HOSTS
# LINKEDIN_STORAGE_STATE=D:/LearningProject/Claude/.secrets/linkedin_storage_state.json

# ── Enrichment / dual-apply throttling ───────────────────────────────────────
# Хосты, для которых НЕ делать обогащение деталей в ханте (они хард-блокят →
# 429/403 и засоряют общий лимит). Стаб из письма-алерта сохраняется. После
# настройки LinkedIn-сессии убери отсюда linkedin.com.
# GMAIL_ENRICH_SKIP_HOSTS=linkedin.com,pracuj.pl
# Жёсткий потолок времени на теневой прогон dual (отдельный процесс), сек.
# Дефолт 3600: shadow гоняет полный пайплайн (judge + verdict refine loop,
# с 2026-08-10 до 5 раундов).
# DUAL_SHADOW_TIMEOUT_SEC=3600
# Потолок на apply-ран, который может идти через Claude CLI (подписка).
# Дефолт 10800 (3 ч): 5-раундовый refine-цикл через CLI (по ≤600 сек на вызов)
# сам по себе может занять ~2 часа; "время есть, пускай ковыряется".
# APPLY_AGENT_CLI_TIMEOUT_SEC=10800
# Shadow-профиль для dual-режима (deepseek-v3 / deepseek-v4-pro / glm-5.2 / ...).
# Приоритет: /dual shadow <name> в Telegram (DB) → эта переменная → deepseek-v3.
# DUAL_SHADOW_PROFILE=deepseek-v4-pro

# Hunt / apply split (docs/HUNT_APPLY_SPLIT_PLAN.md M1): off (default) applies
# inline under the hunt lock; on writes a PENDING queue row instead and a
# background apply_worker_loop drains it independently.
#APPLY_QUEUE_ENABLED=false
# A PENDING row claimed but never resolved within this many minutes is assumed
# to be a crashed worker and reset back to PENDING.
#APPLY_CLAIM_TIMEOUT_MIN=60

# LinkedIn auto-search
LINKEDIN_ENABLED=true
LINKEDIN_KEYWORDS=angular,frontend developer
LINKEDIN_GEO_ID=105072130

# Guest-search recency window (r86400 = 24h, r604800 = 7 days).
#LINKEDIN_TPR=r604800

# JustJoin.it (Polish market leader) — JSON offers API
JUSTJOIN_ENABLED=true
# Pages per workplaceType (remote/hybrid/office). 1 page = 100 items.
#JUSTJOIN_MAX_PAGES=3

# NoFluffJobs — POST JSON search API, no auth
NOFLUFFJOBS_ENABLED=true

# Pracuj.pl — cloudscraper + __NEXT_DATA__ (Cloudflare-protected)
PRACUJ_ENABLED=true
# pracuj.pl is Cloudflare-rate-limited (HTTP 429 on a burst) — throttle it
# harder than other hosts during Gmail-alert enrichment.
#PRACUJ_HOST_CONCURRENCY=2
#PRACUJ_HOST_DELAY_SEC=1.0

# theprotocol.it — cloudscraper + dehydratedState (Cloudflare-protected)
THEPROTOCOL_ENABLED=true

# Solid.Jobs — RSS feed
SOLIDJOBS_ENABLED=true

# Inhire.io — Playwright + Vuex store (requires Playwright)
INHIRE_ENABLED=true

# JobLeads — HTML scraper; detail pages often Cloudflare-blocked (MANUAL flow)
JOBLEADS_ENABLED=true

# Working Nomads — public Elasticsearch /jobsapi/_search, no auth
WORKINGNOMADS_ENABLED=true

# Jobspresso — WP Job Manager RSS feeds, one per keyword
JOBSPRESSO_ENABLED=true

# Built In — cloudscraper + BeautifulSoup DOM (US/remote tech, Cloudflare)
BUILTIN_ENABLED=true

# JustRemote — JSON API (Heroku backend), ~10 newest dev roles
JUSTREMOTE_ENABLED=true

# FindMyRemote — JSON API, ~21 freshest per query; also fetches findmyremote.ai
# links relayed by the findmyremote_frontend Telegram channel
FINDMYREMOTE_ENABLED=true

# Smart Jobs (thesmartjobs.com) — Polish IT board on the Traffit ATS
THESMARTJOBS_ENABLED=true

# Bot-side relay (hunter/sources/linkedin_scout_relay.py) — receives the
# /scoutfound command sent by the standalone LinkedIn posts scout (separate
# PRIVATE repo, owner's desktop only) and drains its own queue file (entirely
# on the bot's own filesystem) into the normal hunt cycle. No scraping, IS
# part of hunter/ and Docker.
# LINKEDIN_SCOUT_RELAY_ENABLED=true

# Telegram channels source (hunter/sources/telegram_channels.py) — reads
# public t.me/s/{channel} previews (no auth, no MTProto) for an owner-curated
# channel list (telegram_channels.json in the repo root). See
# docs/TELEGRAM_CHANNELS_SOURCE_PLAN.md.
# TELEGRAM_CHANNELS_ENABLED=true
# TELEGRAM_CHANNELS_FILE=telegram_channels.json
# TELEGRAM_CHANNELS_DELAY_SEC=1.5

# Bulldogjob source
BULLDOGJOB_ENABLED=true

# Arbeitnow (EU job board API)
ARBEITNOW_ENABLED=true

# Remotive (remote job board API)
REMOTIVE_ENABLED=true

# Remote OK (remoteok.com/api)
REMOTEOK_ENABLED=true

# Himalayas (himalayas.app/jobs/api)
HIMALAYAS_ENABLED=true

# 4dayweek.io (api/v2/jobs)
FOURDAYWEEK_ENABLED=true

# We Work Remotely (remote-jobs.rss)
WEWORKREMOTELY_ENABLED=true

# RemoteLeaf (HTML listing + pagination; fragile if layout changes)
REMOTELEAF_ENABLED=true

# ATS Aggregator (Workable/Greenhouse/Lever/Recruitee/Ashby).
# Companies listed in hunter/ats_companies.json — add entries there, no code.
ATS_AGGREGATOR_ENABLED=true

# ── Gmail source ──────────────────────────────────────────────────────────────
# Reads job alert emails from LinkedIn/NoFluffJobs/JustJoin/Pracuj. Requires
# one-time setup: python tools/gmail_auth.py
GMAIL_ENABLED=false
# How far back the Gmail scan reads the inbox (hours).
#GMAIL_LOOKBACK_HOURS=25
# Max alert emails per scan; the hunt report warns if the ceiling is hit.
#GMAIL_MAX_RESULTS=100
# Fetch real title/company/location/salary for each URL found in alert emails.
#GMAIL_ENRICH_ENABLED=true
# Global cap on parallel enrichment fetches (all hosts).
#GMAIL_ENRICH_CONCURRENCY=5
# Per-job HTTP timeout (seconds) for an enrichment fetch.
#GMAIL_ENRICH_TIMEOUT=15
# Default per-host concurrent enrichment fetches.
#GMAIL_ENRICH_DOMAIN_LIMIT=2
# Default per-host delay (sec) between enrichment fetches.
#GMAIL_ENRICH_DOMAIN_DELAY=0.0
# Apply a "Job Hunter/Processed" Gmail label to every alert email read during
# a hunt. Requires the gmail.modify scope — re-run tools/gmail_auth.py after
# upgrading from a pre-labeling install.
#GMAIL_LABEL_PROCESSED=true

# ── Email response checker ────────────────────────────────────────────────────
# Default look-back window (days) for /check_responses and the daily scheduled run.
#EMAIL_RESPONSE_LOOKBACK_DAYS=2
# Time of day (Warsaw) for the daily automatic confirmation check.
#EMAIL_RESPONSE_CHECK_TIME=09:00

# ── Expired-check schedule + concurrency ──────────────────────────────────────
# Time of day (Warsaw) for the daily /check_expired sweep.
#EXPIRED_CHECK_TIME=00:00
# Global max parallel requests during /check_expired.
#EXPIRED_CHECK_CONCURRENCY=10
# Max simultaneous requests to the same domain.
#EXPIRED_CHECK_DOMAIN_LIMIT=2
# Delay (sec) between requests to the same domain.
#EXPIRED_CHECK_DOMAIN_DELAY=1.0
# Hard per-URL fetch timeout (sec) — guards against TCP hangs.
#EXPIRED_CHECK_FETCH_TIMEOUT=35.0

# ── Scraper health monitoring ─────────────────────────────────────────────────
# Track per-source raw yield per hunt; alert when a previously-working source
# goes dry for N consecutive runs.
#SOURCE_HEALTH_ENABLED=true
#SOURCE_HEALTH_ALERT_STREAK=3
# Per-source run rows retained (ring buffer).
#SOURCE_HEALTH_KEEP=50

# ── Market memory: postings_seen (docs/MARKET_MEMORY_PLAN.md M1) ─────────────
# Keep one row of listing METADATA (title/company/location/salary/filter
# verdict — never the posting text) per vacancy any source returned, so the
# ~90% of listings the filters reject still leave a trace for reports. The
# table is reports-only: nothing reads it back into the hunt or the apply
# pipeline. `false` skips the write while leaving the table in place.
#POSTINGS_SEEN_ENABLED=true
# Nightly prune (00:40) deletes rows not seen for this many days.
#POSTINGS_TTL_DAYS=180

# ── Hunt funnel: hunt_runs (docs/PIPELINE_VIZ_PLAN.md M1) ────────────────────
# Persist one row per hunt with the numbers its Telegram report already shows
# (found -> filtered -> duplicates -> new -> queued/applied), so a pipeline
# page can draw the funnel. Counts only — never a job, URL or title.
# Reports-only: nothing reads it back. `false` skips the write, table stays.
#HUNT_RUNS_ENABLED=true
# Rows retained (ring buffer; ~100 hunts/day in prod, 2000 ≈ 3 weeks).
#HUNT_RUNS_KEEP=2000

# ── Pipeline page control (bot_commands + hunt_live) ─────────────────────────
# The site's /pipeline page (owner only) can start a hunt (all sources or one),
# a retry of FAILed rows or an expired check by inserting a `bot_commands` row
# into the shared tracker.db; the bot drains it every 3 s. `false` stops the
# drain (rows stay pending). hunt_live keeps one row per hunt so the page can
# show which step is running right now.
#BOT_COMMANDS_ENABLED=true
# hunt_live rows retained (ring buffer).
#HUNT_LIVE_KEEP=500

# ── Google Sheets integration ─────────────────────────────────────────────────
# See the "Google Sheets Setup" section in CLAUDE.md for the one-time OAuth flow.
GSHEETS_ENABLED=false
# Spreadsheet ID — set after first run (bot creates the sheet and sends you the ID).
#GSHEETS_TRACKER_ID=
# How often (minutes) to pull Sheets -> tracker.db to pick up user edits.
#GSHEETS_REFRESH_INTERVAL_MIN=30

# ── Google Drive integration ──────────────────────────────────────────────────
GDRIVE_ENABLED=false
# Optional: ID of an existing Drive folder to upload into (auto-creates the
# root folder below when unset).
#GDRIVE_ROOT_FOLDER_ID=
#GDRIVE_ROOT_FOLDER_NAME=Job Hunter

# ── Tracker / to_send backups ─────────────────────────────────────────────────
# Daily copy when hunter.py runs (JobQueue) + manual: python tools/backup_tracker.py
# Backs up tracker.db (sqlite3.Connection.backup(), WAL-safe) + optionally
# job-hunter-api's app.sqlite (APP_SQLITE_PATH below) + the legacy tracker.xlsx
# workbook when present. See docs/DEPLOY.md "Backups" + docs/improvement-2026-09/06-OPS_PLAN.md M1.
# TRACKER_BACKUP_ENABLED=true
# TRACKER_BACKUP_DIR=D:/LearningProject/Claude/backups
# TRACKER_BACKUP_KEEP_FILES=90
# TRACKER_BACKUP_TIME=06:05

# Optional: path to job-hunter-api's app.sqlite (users/auth/profiles), if that
# stack's data dir is reachable from this container/host. Unset = skipped.
# APP_SQLITE_PATH=/app/api-data/app.sqlite

# ── Per-source staggered schedule ─────────────────────────────────────────────
# Base trigger times for a full sweep of every source (comma-separated HH:MM,
# Warsaw time). Default is night-weighted: two of the four cycles start inside
# 02:00-08:00. With APPLY_QUEUE_ENABLED the apply worker picks a queued job up
# within ~15 s, so this grid also decides WHEN documents get generated.
# SCHEDULE_TIMES=02:00,05:00,08:00,13:00

# Minutes to offset each source from the base SCHEDULE_TIMES.
# With 4 sources and offset=60, base 08:00 → 08:00 / 09:00 / 10:00 / 11:00
SCHEDULE_SOURCE_OFFSET_MIN=60

# Quiet hours — no hunt slot ever fires inside this window ("HH:MM-HH:MM", may
# wrap midnight; an end of 00:00 means end-of-day; empty disables it). Needed
# on top of SCHEDULE_TIMES because one cycle of 25 sources at 40 min spans
# 16h40m, so a daytime base time wraps into the evening on its own.
# SCHEDULE_BLACKOUT=18:00-00:00

# When to retry FAILed tracker rows (comma-separated HH:MM, Warsaw time).
# Used to run after every per-source hunt; now on its own slots. Minutes :45
# never collide with the hunt grid (which only fires at :00/:20/:40). Keep
# these inside the quiet-hours-free window — a retry runs the apply pipeline.
# RETRY_FAILED_TIMES=02:45,07:45

# Drive backfill interval (minutes) for application folders that missed their
# instant post-apply upload (idempotent safety net; was 3 h).
# GDRIVE_UPLOAD_MISSING_INTERVAL_MIN=30

# Socket-level timeout (seconds) on the Drive API's underlying httplib2.Http.
# Bounds how long a hung read can block a worker thread (and the shared TLS
# socket it holds) — see docs/GDRIVE_SSL_RACE_PLAN.md M2.
# GDRIVE_HTTP_TIMEOUT_SEC=60
